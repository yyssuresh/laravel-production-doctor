
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laravel Production Doctor JSON Report",
  "description": "Schema for the machine-readable diagnostic report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "generated_at",
    "checks",
    "summary"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the project directory being checked."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the report was generated."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "message",
          "recommendation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail",
              "skip"
            ]
          },
          "message": {
            "type": "string"
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "warning",
        "fail",
        "skip"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
