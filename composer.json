{
    "name": "yyssuresh/laravel-production-doctor",
    "description": "A safe, read-only CLI health checker for Laravel production deployments.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelProductionDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelProductionDoctor\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/laravel-doctor"
    ],
"scripts": {
    "test": "phpunit",
    "check": [
        "@check-cli",
        "@check-source",
        "@check-tests"
    ],
    "check-cli": "@php -l bin/laravel-doctor",
    "check-source": [
        "@php -l src/CheckResult.php",
        "@php -l src/Doctor.php",
        "@php -l src/Support/EnvFile.php"
    ],
    "check-tests": [
        "@php -l tests/DoctorTest.php",
        "@php -l tests/EnvFileTest.php",
        "@php -l tests/CliTest.php",
        "@php -l tests/FixtureIntegrationTest.php"
    ]
},
    "minimum-stability": "stable",
    "prefer-stable": true
}
